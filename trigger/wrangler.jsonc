// The bot's 20-minute clock: a Cloudflare Worker with a cron trigger (UTC). It has no
// routes and no workers.dev URL, so nothing can reach it over the web.
// Deploy from the repo root with: npx wrangler deploy --config trigger/wrangler.jsonc
{
  "name": "metaculus-bot-trigger",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["7,27,47 * * * *"] },
  "observability": { "enabled": true }
}
